<table class="table table-hover">
  <thead>
    <tr class="bg-light">
      <th class="col-1 bg-secondary-subtle">
        <div class="d-flex justify-content-between align-items-end">
          Дата
          <% unless Day.where(date: Date.current).exists? %>
            <%= link_to days_path, data: { turbo_method: :post } do %>
              <i class="bi bi-plus-square-fill"></i>
            <% end %>
          <% end %>
        </div>
      </th>
      <% User.order(:id).each do |user| %>
        <th class="col-1"><%= link_to user.name, edit_user_path(user) %></th>
      <% end %>
      <th class="text-end col-1" >
        <%= link_to new_user_path do %>
          <i class="bi bi-plus-square-fill"></i>
        <% end %>
      </th>
    </tr>
  </thead>
  <tbody class="table-group-divider">
    <% Day.order(date: :desc).each do |day| %>
    <tr>
      <td><%= day.date.strftime("%d.%m") %></td>
      <% User.order(:id).each do |user| %>
        <td>
          <% day.tasks.where(user_id: user.id).order(:summary).each do |task| %>
            <div>
              <% if task.completed? %>
                <% if task_change_allowed?(day) %>
                  <%= link_to restore_user_task_path(user, task), class: "text-decoration-none text-black", data: { turbo_method: :patch } do %>
                    <i class="bi bi-check-square-fill"></i>
                  <% end %>
                <% else %>
                  <i class="bi bi-check-square-fill text-secondary"></i>
                <% end %>
              <% else %>
                <% if task_change_allowed?(day) %>
                  <%= link_to complete_user_task_path(user, task), class: "text-decoration-none text-black", data: { turbo_method: :patch } do %>
                    <i class="bi bi-check-square"></i>
                  <% end %>
                <% else %>
                  <i class="bi bi-check-square text-secondary"></i>
                <% end %>
              <% end %>
              <%= link_to task.summary, edit_user_task_path(user, task), class: "text-decoration-none text-black" %>
            </div>
          <% end %>
          <% if day.date == Date.current %>
            <div>
              <%= link_to new_user_task_path(user) do %>
                <i class="bi bi-plus-square-fill"></i>
              <% end %>
            </div>
          <% end %>
        </td>
      <% end %>
      <td></td>
    </tr>
    <% end %>
  </tbody>
</table>