<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-4">
      <p>Добавление новой задачи.</p>
      <%= simple_form_for [@user, @task] do |f| %>
        <%= f.input :summary, placeholder: "Описание задачи", label: false, input_html: { autofocus: true } %>
        <div class="d-flex justify-content-between">
          <%= f.submit "Сохранить", class: "btn btn-primary" %>
          <%= link_to "Удалить", [@user, @task], class: "btn btn-outline-danger ms-2", data: { turbo_method: :delete } %>
        </div>
      <% end %>
    </div>
  </div>
</div>