<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-4">
      <p>Редактирование сотрудника.</p>
      <%= simple_form_for @user do |f| %>
        <%= f.input :name, placeholder: "Имя", label: false, input_html: { autofocus: true } %>
        <%= f.submit "Создать", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>